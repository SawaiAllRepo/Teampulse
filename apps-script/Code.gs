function cell_(v){return typeof v==='string'&&/^[=+\-@]/.test(v)?"'"+v:v}
function append_(k,r){spreadsheet_().getSheetByName(k).appendRow(SCHEMA[k].map(h=>cell_(r[h]??'')))}
